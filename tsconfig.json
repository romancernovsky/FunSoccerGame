{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src",
    "server",
    "tests",
    "vite.config.ts",
    "scripts",
    "playwright.config.ts",
    "playwright.final-minute.config.ts"
  ]
}
